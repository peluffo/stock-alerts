{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "ConnectionStrings": {
    "Postgres": "${POSTGRES_CONNECTION}",
    "Redis": "${REDIS_CONNECTION}"
  },
  "Finnhub": {
    "ApiKey": "${FINNHUB_API_KEY}",
    "RateLimitPerMinute": 55
  }
}
